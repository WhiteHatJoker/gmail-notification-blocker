# Copy to /etc/gmail-notification-blocker.env on your server, fill in real values,
# then: chown root:root /etc/gmail-notification-blocker.env && chmod 600 /etc/gmail-notification-blocker.env
#
# systemd EnvironmentFile format: KEY=value, one per line, NO `export`, NO quotes
# unless you want them to be part of the value.

# --- Gmail OAuth (needs the gmail.modify scope, see README) ---
GMAIL_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=xxxxxxxx
GMAIL_REFRESH_TOKEN=1//xxxxxxxx

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Optional. Defaults to claude-haiku-4-5 (cheapest, ideal for URGENT/OK triage).
# ANTHROPIC_MODEL=claude-haiku-4-5
# Optional. Your own triage instructions; the model must reply with URGENT or OK.
# TRIAGE_PROMPT=You filter my inbox. Reply ONLY with URGENT or OK. URGENT means ...

# --- Telegram ---
TELEGRAM_TOKEN=123456:xxxxxxxx
TELEGRAM_CHAT_ID=123456789

# --- Sender rules (comma-separated; matched case-insensitively against the From header) ---
# Skipped entirely — labelled Alerted, never sent to Claude or Telegram:
IGNORE_SENDERS=
# Always alerted without asking Claude, regardless of content:
FORCE_IMPORTANT_SENDERS=
# Voicemail-notification senders (e.g. notify@ringcentral.com). A voicemail WITH a
# "Voicemail Preview" transcript is judged by Claude on the normal path; a voicemail
# WITHOUT a transcript is alerted unconditionally (Claude can't read the audio).
VOICEMAIL_SENDERS=

# --- Optional tuning (defaults shown) ---
# GMAIL_QUERY=is:unread -label:Alerted
# ALERTED_LABEL=Alerted
# POLL_SECONDS=90
# MAX_BODY_CHARS=4000
# MAX_PER_CYCLE=25
